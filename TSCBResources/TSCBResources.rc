#include "resource.h"
#include <windows.h>
#include "..\Common\Version.h"

// Embedded Font Resources
IDR_FONT_SEGOE_MDL2     RCDATA      "Fonts\\segmdl2.ttf"
IDR_FONT_SEGOE_ICONS    RCDATA      "Fonts\\SegoeIcons.ttf"
IDR_FONT_SEGOE_UI       RCDATA      "Fonts\\segoeui.ttf"
IDR_FONT_SEGOE_SB       RCDATA      "Fonts\\seguisb.ttf"

// Version Information
VS_VERSION_INFO VERSIONINFO
 FILEVERSION TSCB_FILEVERSION_NUM
 PRODUCTVERSION TSCB_PRODUCTVERSION_NUM
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Train Sim Consist Builder for Open Rails"
            VALUE "FileDescription", "Train Sim Consist Builder Resource & Embedded Font Library"
            VALUE "FileVersion", TSCB_FILEVERSION_STR
            VALUE "InternalName", "TSCBResources.dll"
            VALUE "LegalCopyright", "Copyright (C) 2026 Train Sim Consist Builder for Open Rails. All rights reserved."
            VALUE "OriginalFilename", "TSCBResources.dll"
            VALUE "ProductName", "Train Sim Consist Builder"
            VALUE "ProductVersion", TSCB_VERSION_STR
            VALUE "BuildNumber", TSCB_BUILD_NUMBER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
