#include "resource.h"
#include <windows.h>
#include "..\Common\Version.h"

IDI_TRAINSIMCONSISTBUILDER ICON "Resources\\TrainSimConsistBuilder.ico"
IDI_SMALL                  ICON "Resources\\small.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION TSCB_FILEVERSION_NUM
 PRODUCTVERSION TSCB_PRODUCTVERSION_NUM
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Train Sim Consist Builder for Open Rails"
            VALUE "FileDescription", "Train Sim Consist Builder"
            VALUE "FileVersion", TSCB_FILEVERSION_STR
            VALUE "InternalName", "TrainSimConsistBuilder.exe"
            VALUE "LegalCopyright", "Copyright (C) 2026 Train Sim Consist Builder for Open Rails. All rights reserved."
            VALUE "OriginalFilename", "TrainSimConsistBuilder.exe"
            VALUE "ProductName", "Train Sim Consist Builder"
            VALUE "ProductVersion", TSCB_VERSION_STR
            VALUE "BuildNumber", TSCB_BUILD_NUMBER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
